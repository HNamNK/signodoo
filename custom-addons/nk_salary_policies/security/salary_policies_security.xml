<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- ✅ Group cơ bản -->
        <record id="group_salary_policies" model="res.groups">
            <field name="name">Nhóm Chính Sách Lương</field>  
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Quản lý chính sách lương theo công ty được phân quyền</field>
        </record>
        
        <!-- ✅ BATCH: User chỉ xem batch tự tạo -->
        <record id="rule_salary_batch_own_created" model="ir.rule">
            <field name="name">Batch: Chỉ Xem Batch Tự Tạo</field>
            <field name="model_id" ref="model_nk_salary_policies_batch"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_salary_policies'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ✅ BATCH: Admin xem tất cả -->
        <record id="rule_salary_batch_admin_all" model="ir.rule">
            <field name="name">Batch: Admin Xem Tất Cả</field>
            <field name="model_id" ref="model_nk_salary_policies_batch"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <!-- ✅ FIELD CONFIG: User chỉ đọc -->
        <record id="rule_field_config_read_only" model="ir.rule">
            <field name="name">Field Config: Chỉ Đọc</field>
            <field name="model_id" ref="model_nk_salary_policies_field_config"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_salary_policies'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ✅ FIELD CONFIG: Admin toàn quyền -->
        <record id="rule_field_config_admin_all" model="ir.rule">
            <field name="name">Field Config: Admin Toàn Quyền</field>
            <field name="model_id" ref="model_nk_salary_policies_field_config"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

    </data>
</odoo>